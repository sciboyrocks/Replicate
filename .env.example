# All credentials stay on the server. Copy to .env.local and restart.
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# HF Inference Providers are paid/credits; requires allow-paid in the UI.
HF_TOKEN=
# Optional exact checkpoint adapters; configure only adapters you actually run.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_API_KEY=
# Explicit researcher attestation: map catalog ID to your exact installed checkpoint.
